{% extends 'base.html.twig' %}

{% block title %}Voir contact - ORMada{% endblock %}

{% block body %}

<div class="h-full flex flex-col">

    <!-- HEADER -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-4 ">

        <div class="h-1.5 bg-gradient-to-r from-emerald-700 via-emerald-500 to-cyan-500"></div>

        <div class="px-6 py-4 flex justify-between items-center">

            <div class="flex items-center gap-4">

                <div class="w-14 h-14 rounded-2xl bg-emerald-100
                            flex items-center justify-center">

                    <svg class="w-7 h-7 text-emerald-700"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 8V7l-3 2-2-2-3 2-2-2-3 2-2-2-3 2v9h18V8z"/>

                    </svg>

                </div>

                <div>

                    <h1 class="text-2xl font-bold text-gray-800">

                        {{ contact.nom }}

                    </h1>

                    <p class="text-sm text-gray-500">

                        {{ contact.email }}

                    </p>

                </div>

            </div>

            {% if contact.dejalu %}
                <span class="px-4 py-1 rounded-full
                            bg-emerald-100 text-emerald-700
                            text-sm font-semibold">

                    Lu

                </span>
            {% else %}
                <span class="px-4 py-1 rounded-full
                            bg-yellow-100 text-yellow-700
                            text-sm font-semibold">

                    Nouveau

                </span>
            {% endif %}

        </div>

    </div>


    <!-- CONTENU -->
    <div class="flex-1 bg-white rounded-2xl shadow-lg p-5 flex flex-col">

        <div class="grid grid-cols-2 gap-4 mb-4">

            <div>

                <p class="text-xs font-semibold text-gray-500 mb-1">
                    ID
                </p>

                <div class="bg-gray-50 p-3 rounded-xl">

                    #{{ contact.id }}

                </div>

            </div>

            <div>

                <p class="text-xs font-semibold text-gray-500 mb-1">
                    Envoyer le
                </p>

                <div class="bg-gray-50 p-3 rounded-xl">

                    {{ contact.creerle|date('d/m/Y H:i') }}

                </div>

            </div>

        </div>

        <div class="mb-4">

            <p class="text-xs font-semibold text-gray-500 mb-1">

                Sujet

            </p>

            <div class="bg-gray-50 p-3 rounded-xl">

                {{ contact.titre }}

            </div>

        </div>


        <!-- message prend l'espace restant -->
        <div class="flex-1 flex flex-col">

            <p class="text-xs font-semibold text-gray-500 mb-1">

                Message

            </p>

            <div class="flex-1 bg-gray-50 rounded-xl p-4
                        text-gray-700 leading-relaxed
                        overflow-auto">

                {{ contact.description }}

            </div>

        </div>

    </div>


    <!-- BOUTONS -->
    <div class="mt-4 mb-10 flex justify-between">

        <a href="{{ path('app_contact_index') }}"
        class="px-5 py-2 rounded-xl
                border border-gray-300
                hover:bg-gray-100
                transition">

            Retour

        </a>

      

    </div>

</div>

{% endblock %}