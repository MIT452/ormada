<form method="post" action="{{ path('app_contact_delete', {'id': contact.id}) }}" onsubmit="return confirm('⚠️ Êtes-vous sûr de vouloir supprimer ce contact ? Cette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
   
        <button type="submit" class="px-3 py-2 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-lg transition-colors duration-200 shadow-md">
            <span class="flex items-center gap-1">
                <span>🗑️</span>
                <span>Supprimer</span>
            </span>
        </button>
   
</form>
