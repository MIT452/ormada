{% extends 'base.html.twig' %}

{% block title %}Contacts - ORMada{% endblock %}

{% block body %}

<div class="h-full flex flex-col overflow-hidden bg-gradient-to-br from-slate-50 via-emerald-50 to-white">

    <!-- HEADER -->
    <section class="shrink-0 bg-gradient-to-r from-emerald-800 via-emerald-700 to-emerald-600  shadow-xl">

        <div class="px-8 py-5 flex items-center justify-between">

            <div>

                <h1 class="text-3xl font-bold text-white">
                    Gestion des Messages
                </h1>

                <p class="text-emerald-100 text-sm mt-1">
                    Administration ORMada
                </p>

            </div>
            <form method="get">

                <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center">

                    <!-- RECHERCHE -->
                    <div class="flex-1">

                    <div class="relative">

                        <input
                            type="text"
                            name="search"
                            value="{{ app.request.get('search') }}"
                            placeholder="Nom, email, titre ou message..."
                            class="w-full px-4 py-2.5
                                rounded-xl
                                border border-gray-200
                                bg-gray-50
                                text-sm
                                focus:bg-white
                                focus:ring-2
                                focus:ring-emerald-500
                                focus:border-emerald-500
                                focus:outline-none
                                transition"
                        >

                    </div>
                    </div>

                    <!-- STATUT -->
                    <div class="w-[70px] md:w-42">

                        <select
                            name="dejalu"
                            class="w-full px-4 py-2.5
                                rounded-xl
                                border border-gray-200
                                bg-gray-50
                                text-sm
                                focus:bg-white
                                focus:ring-2
                                focus:ring-emerald-500
                                focus:border-emerald-500
                                focus:outline-none">

                            <option value="">Tous</option>

                            <option value="1"
                                {% if app.request.get('dejalu') == '1' %}
                                    selected
                                {% endif %}
                            >
                                Lu
                            </option>

                            <option value="0"
                                {% if app.request.get('dejalu') == '0' %}
                                    selected
                                {% endif %}
                            >
                                Non lu
                            </option>

                        </select>

                    </div>

                    <!-- BOUTON RECHERCHE -->
                    <button
                        type="submit"
                        class="w-full md:w-auto px-6 py-2.5
                            rounded-xl
                            bg-emerald-700
                            hover:bg-emerald-800
                            text-white
                            text-sm
                            font-semibold
                            shadow-md
                            transition">

                        Rechercher

                    </button>

                    <!-- RESET -->
                    <a href="{{ path('app_contact_index') }}"
                    class="w-full md:w-auto px-6 py-2.5
                            rounded-xl
                            border border-gray-300
                            text-center
                            text-gray-700
                            text-sm
                            font-semibold
                            hover:bg-gray-100
                            transition">

                        Reset

                    </a>

                </div>

            </form>
        </div>

    </section>


    <!-- TABLE CARD -->
    <div class="flex-1 mt-4 bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden flex flex-col">

        <!-- TOP BAR -->
        <div class="shrink-0 px-6 py-4 border-b bg-gray-50">

            <div class="flex justify-between items-center">

                <h2 class="text-lg font-semibold text-gray-700">

                    Liste des messages

                </h2>

                <span class="px-4 py-2 rounded-xl bg-emerald-100 text-emerald-700 text-sm font-semibold">

                    {{ contacts|length }} messages

                </span>

            </div>

        </div>


        <!-- TABLE -->
        <div class="flex-1 overflow-y-auto">

            <table class="w-full">

                <!-- HEADER FIXE -->
                <thead class="sticky top-0 z-20 bg-gradient-to-r from-emerald-800 to-emerald-600 text-white">

                    <tr>

                        <th class="px-6 py-4 text-left font-semibold">
                            ID
                        </th>

                        <th class="px-6 py-4 text-left font-semibold">
                            Nom
                        </th>

                        <th class="px-6 py-4 text-left font-semibold">
                            Email
                        </th>

                        <th class="px-6 py-4 text-left font-semibold">
                            Sujet
                        </th>

                        <th class="px-6 py-4 text-left font-semibold">
                            Date
                        </th>

                        <th class="px-6 py-4 text-left font-semibold">
                            Statut
                        </th>

                        <th class="px-6 py-4 text-center font-semibold">
                            Actions
                        </th>

                    </tr>

                </thead>


                <!-- BODY SCROLLABLE -->
                <tbody class="divide-y divide-gray-100">

                {% for contact in contacts %}

                    <tr class="hover:bg-emerald-50 transition duration-300">

                        <!-- ID -->
                        <td class="px-6 py-4">

                            <span class="font-semibold text-gray-800">

                                #{{ contact.id }}

                            </span>

                        </td>


                        <!-- NOM -->
                        <td class="px-6 py-4">

                            <div class="font-semibold text-gray-800">

                                {{ contact.nom }}

                            </div>

                        </td>


                        <!-- EMAIL -->
                        <td class="px-6 py-4">

                            <a href="mailto:{{ contact.email }}"
                               class="text-emerald-700 hover:text-emerald-900 hover:underline">

                                {{ contact.email }}

                            </a>

                        </td>


                        <!-- TITRE -->
                        <td class="px-6 py-4 text-gray-700">

                            {{ contact.titre }}

                        </td>


                        <!-- DATE -->
                        <td class="px-6 py-4 text-gray-600">

                            {{ contact.creerle ? contact.creerle|date('d/m/Y') : 'N/A' }}

                        </td>


                        <!-- STATUS -->
                        <td class="px-6 py-4">

                            {% if contact.dejalu %}

                                <span class="px-4 py-2 rounded-full
                                    bg-emerald-100
                                    text-emerald-700
                                    text-xs font-bold">

                                    Lu

                                </span>

                            {% else %}

                                <span class="px-4 py-2 rounded-full
                                    bg-red-100
                                    text-red-700
                                    text-xs font-bold">

                                    Nouveau

                                </span>

                            {% endif %}

                        </td>


                        <!-- ACTIONS -->
                        <td class="px-6 py-4">

                            <div class="flex justify-center gap-2">

                                <a href="{{ path('app_contact_show', {'id': contact.id}) }}"
                                   class="px-4 py-2 rounded-xl
                                          bg-emerald-600
                                          hover:bg-emerald-700
                                          text-white text-sm
                                          font-medium
                                          transition">

                                    Voir

                                </a>

                                {{ include('contact/_delete_form.html.twig') }}

                            </div>

                        </td>

                    </tr>

                {% else %}

                    <tr>

                        <td colspan="7"
                            class="h-[300px] text-center">

                            <div class="flex flex-col items-center justify-center">

                                <div class="w-20 h-20 rounded-full bg-gray-100 mb-4"></div>

                                <p class="text-lg font-semibold text-gray-500">

                                    Aucun message trouvé

                                </p>

                            </div>

                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}