<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Admin</title>
     <link rel="stylesheet" href="{{ asset('styles.css') }}">
      <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    {# <script src="https://cdn.tailwindcss.com"></script> #}
</head>

<body class="bg-gray-50 min-h-screen flex flex-col">

<!-- NAVBAR -->
<nav class="fixed top-0 left-0 right-0 z-50
            bg-emerald-700 backdrop-blur-md
            border-b border-emerald-100
            shadow-lg">

    <div class="px-6 py-3 flex justify-between items-center">

        <!-- LOGO + ADMIN -->
        <div class="flex items-center gap-5">
            <div class="flex items-center gap-3">

                <div class="w-12 h-12 shadow-sm overflow-hidden flex items-center justify-center">

                    <img src="{{ asset('images/Logo.jpg') }}"
                 class="h-12 w-12 rounded-full object-cover border-2 border-white shadow-md">

                </div>

            </div>

            <!-- Admin connecté -->

            <div>

            
                <p class="text-xs text-white/80">
                            Connecté en tant que
                </p>
                <p class="font-semibold text-white text-sm">
                            {{ app.user.email }}
                </p>

            </div>

                

        </div>


        <!-- Menu -->
        <div class="flex items-center gap-4">

            <!-- Gestion site -->
            <a href="{{ path('app_actualite_index') }}"
            class="flex items-center gap-2
                    px-5 py-2.5
                    rounded-2xl
                    text-sm
                    font-semibold
                    transition duration-300
                    bg-emerald-600 text-white shadow-md
                    hover:bg-emerald-700

                  
            ">

                Gestion du site

            </a>

            <!-- Déconnexion -->
            {% if app.user %}
                <a href="{{ path('app_logout') }}"
                class="px-5 py-2.5
                        rounded-2xl
                        bg-red-500
                        hover:bg-red-600
                        text-white
                        text-sm
                        font-semibold
                        shadow-md
                        hover:shadow-lg
                        transition duration-300">

                    Déconnexion

                </a>
            {% endif %}

        </div>

    </div>

</nav>

<!-- espace pour navbar fixe -->
<div class="h-20"></div>

    <!-- CONTENU PRINCIPAL -->

    {# Message afficher apres une action de suppression d'une actualité ou d'un événement #}
    {% for message in app.flashes('success') %}
        <div class="bg-green-100 text-green-800 px-4 py-3 rounded mb-4">
            {{ message }}
        </div>
    {% endfor %}


   
    <style>
        * {
            font-family: 'Inter', sans-serif;
        }
        
        /* Animations personnalisées */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .card-animate {
            animation: fadeInUp 0.5s ease-out forwards;
            opacity: 0;
        }
        
        .card-animate:nth-child(1) { animation-delay: 0.1s; }
        .card-animate:nth-child(2) { animation-delay: 0.2s; }
        .card-animate:nth-child(3) { animation-delay: 0.3s; }
        .card-animate:nth-child(4) { animation-delay: 0.4s; }
        .card-animate:nth-child(5) { animation-delay: 0.5s; }
        .card-animate:nth-child(6) { animation-delay: 0.6s; }
        
        /* Effet de survol personnalisé */
        .card-hover-effect {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .card-hover-effect:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: 0 20px 25px -12px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }
        
        /* Dégradé pour les bordures */
        .gradient-border {
            position: relative;
            background: white;
            border-radius: 1rem;
        }
        
        .gradient-border::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, #10b981, #34d399, #6ee7b7);
            border-radius: 1rem;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: -1;
        }
        
        .gradient-border:hover::before {
            opacity: 1;
        }
        
        /* Scrollbar personnalisée */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #10b981, #34d399);
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #059669;
        }
        
        /* Badge animation */
        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }
        
        .badge-new {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        
        /* Style pour le texte */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-50 via-gray-100 to-gray-50">

    <main class="flex-grow container mx-auto px-6 py-12">
        
        <!-- En-tête décoratif -->
        <div class="mb-12 text-center">
            <div class="inline-flex items-center justify-center mb-4">
                <div class="h-1 w-12 bg-gradient-to-r from-green-400 to-green-600 rounded-full"></div>
                <div class="mx-3">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div class="h-1 w-12 bg-gradient-to-r from-green-400 to-green-600 rounded-full"></div>
            </div>
            <h1 class="text-4xl font-bold bg-gradient-to-r from-green-700 to-green-600 bg-clip-text text-transparent mb-2">
                Tableau de bord
            </h1>
            <p class="text-gray-500 text-sm">Restez informé des dernières actualités et événements</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
            
            <!-- Dernières actualités -->
            <section>
            
               
          

                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center space-x-3">
                        <div class="bg-gradient-to-br from-green-500 to-green-600 p-2 rounded-xl shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Dernières Actualités</h2>
                            <p class="text-xs text-gray-500 mt-1">Actualités récentes et annonces</p>
                        </div>
                    </div>
                    <span class="text-xs font-medium text-green-600 bg-green-100 px-3 py-1 rounded-full">6 articles</span>
                </div>

                <div class="grid gap-6 mt-4">

                    {% for actualite in actualites %}
                        
                        <!-- Card Actualité 1 -->
                        <div class="gradient-border card-hover-effect rounded-2xl bg-white p-6 border border-gray-100 shadow-sm card-animate">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex-1">
                                    <div class="flex items-center space-x-2 mb-2">
                                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-lg">📢 Annonce</span>
                                        <span class="badge-new px-2 py-1 bg-red-100 text-red-600 text-xs font-semibold rounded-lg">Nouveau</span>
                                    </div>
                                       <div class="w-40">
                                            {% set image = actualite.media|first %}

                                            {% if image %}
                                                <img src="{{ asset(image.chemindufichier) }}"
                                                    class="w-full h-28 object-cover rounded-lg">
                                            {% else %}
                                                <img src="{{ asset('images/default.jpg') }}"
                                                    class="w-full h-28 object-cover rounded-lg">
                                            {% endif %}
                                        </div>
                                    <h3 class="text-lg font-bold text-gray-800 mb-2 hover:text-green-700 transition-colors cursor-pointer">
                                        {{ actualite.titre }}
                                    </h3>
                                </div>
                                <svg class="w-5 h-5 text-gray-400 hover:text-green-600 transition-colors cursor-pointer" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </div>
                            <div class="flex items-center space-x-4 text-sm text-gray-500 mb-3">
                                <div class="flex items-center space-x-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    <span>Publier le {{ actualite.publierle|date('d/m/Y') }}</span>
                                </div>
                                <div class="flex items-center space-x-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                    <span>Admin</span>
                                </div>
                            </div>
                            <p class="text-gray-600 text-sm leading-relaxed line-clamp-2">
                                {{ actualite.contenu|slice(0, 120) }} </p>
                            <div class="mt-4 pt-3 border-t border-gray-100">
                                <button class="text-green-600 hover:text-green-700 text-sm font-medium flex items-center space-x-1 transition-colors">
                                    <span>Lire la suite</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                    {% endfor %}
                    
                </div>
            </section>


            <!-- Derniers événements -->
            <section>
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center space-x-3">
                        <div class="bg-gradient-to-br from-blue-500 to-blue-600 p-2 rounded-xl shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800">Derniers Événements</h2>
                            <p class="text-xs text-gray-500 mt-1">Événements à venir et passés</p>
                        </div>
                    </div>
                    <span class="text-xs font-medium text-blue-600 bg-blue-100 px-3 py-1 rounded-full">6 événements</span>
                </div>

                <div class="grid gap-6 mt-4">
                {% for event in evenements %}

                    <!-- Card Événement 1 -->
                    <div class="gradient-border card-hover-effect rounded-2xl bg-white p-6 border border-gray-100 shadow-sm card-animate">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex-1">
                                <div class="flex items-center space-x-2 mb-2">
                                    <span class="px-2 py-1 bg-orange-100 text-orange-700 text-xs font-semibold rounded-lg">🎪 Salon</span>
                                    <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-lg">Bientôt</span>
                                </div>
                                {% set image = event.media|first %}

                                {% if image %}
                                    <img src="{{ asset(image.chemindufichier) }}"
                                        class="w-full h-28 object-cover rounded-lg">
                                {% else %}
                                    <img src="{{ asset('images/default.jpg') }}"
                                        class="w-full h-28 object-cover rounded-lg">
                                {% endif %}
                                                        <h3 class="text-lg font-bold text-gray-800 mb-2 hover:text-green-700 transition-colors cursor-pointer">
                                    {{ event.titre }}
                                </h3>
                            </div>
                            <svg class="w-5 h-5 text-gray-400 hover:text-green-600 transition-colors cursor-pointer" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </div>
                        <div class="flex items-center space-x-4 text-sm text-gray-500 mb-3">
                            <div class="flex items-center space-x-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <span>{{ event.datedudebut|date('d/m/Y') }} </span>
                                <span>{{ event.datedufin|date('d/m/Y') }} </span>
                            </div>
                            <div class="flex items-center space-x-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span>Antananarivo</span>
                            </div>
                        </div>
                        <p class="text-gray-600 text-sm leading-relaxed line-clamp-2">
                            {{ event.description }}
                        </p>
                        <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between">
                            <button class="text-green-600 hover:text-green-700 text-sm font-medium flex items-center space-x-1 transition-colors">
                                <span>En savoir plus</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </button>
                            <span class="text-xs text-gray-400">📍 10 participants</span>
                        </div>
                    </div>
                {% endfor %}
                    
            </section>
        </div>
    </main>


    <!-- FOOTER -->
    <footer class="bg-[#4b0000] text-white py-12 md:py-16">
        <div class="container mx-auto px-6 grid md:grid-cols-3 gap-6">

            <div>
                <h4 class="font-bold text-lg mb-3">À propos</h4>
                <p class="text-sm">
                    Organisation œuvrant dans le développement du numérique à Madagascar.
                </p>
            </div>

            <div>
                <h4 class="font-bold text-lg mb-3">Contact</h4>
                 {% for parametre in parametres %} 
                    <p class="mb-2">{{ parametre.valeur }}</p>
                {% endfor %}
                
               
            </div>

            <div>
                <h4 class="font-bold text-lg mb-3">Administration</h4>
                <p class="text-sm">Espace réservé aux administrateurs</p>
            </div>

        </div>

        <div class="text-center text-sm mt-6 border-t border-green-500 pt-4">
            © 2026 ORMada - Tous droits réservés
        </div>
    </footer>

</body>
</html>