<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Actualités ORMada</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50">

<!-- HEADER -->
{# <header class="bg-gradient-to-r from-emerald-700 to-emerald-500 text-white p-6 shadow-md">

    <h1 class="text-3xl font-bold">Actualités ORMada</h1>

    <p class="text-sm opacity-90 mt-1">
        Découvrez les dernières informations
    </p>

</header> #}

{% include 'interfacevisiteur/NavbarInterfaceVisiteur.html.twig' %}
<!-- CONTAINER -->
<main class="max-w-6xl mx-auto px-6 mt-16 py-10">


    <!-- FILTRES (statique pour l'instant) -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-8">

        <!-- TEXTE -->
        <div>
            <h1 class="text-3xl font-bold text-gray-800">
                📅 Centre des actualités
            </h1>

            <p class="text-gray-500 mt-1">
                Suivi complet des actualités . Utilisez les filtres pour affiner votre recherche.
            </p>
        </div>

        <!-- BOUTONS FILTRES -->
                <!-- FILTER BAR -->
        <div class="flex flex-wrap gap-3 mb-6">

            <a href="?filter=all"
            class="px-5 py-2 rounded-full text-sm font-semibold
            {{ filter == 'all' ? 'bg-emerald-600 text-white' : 'bg-white border hover:bg-gray-50 text-gray-700' }}">
                Toutes
            </a>

            <a href="?filter=today"
            class="px-5 py-2 rounded-full text-sm font-semibold
            {{ filter == 'today' ? 'bg-emerald-600 text-white' : 'bg-white border hover:bg-gray-50 text-gray-700' }}">
                Aujourd’hui
            </a>

            <a href="?filter=week"
            class="px-5 py-2 rounded-full text-sm font-semibold
            {{ filter == 'week' ? 'bg-emerald-600 text-white' : 'bg-white border hover:bg-gray-50 text-gray-700' }}">
                Cette semaine
            </a>

            <a href="?filter=month"
            class="px-5 py-2 rounded-full text-sm font-semibold
            {{ filter == 'month' ? 'bg-emerald-600 text-white' : 'bg-white border hover:bg-gray-50 text-gray-700' }}">
                Ce mois
            </a>

        </div>

    </div>


    <!-- GRID ACTUALITES -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">



    {% for a in actualites %}

        <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition">

             {# IMAGE PRINCIPALE #}
                    {% set image = a.media|first %}

                    {% if image %}
                        <img src="{{ asset(image.chemindufichier) }}"
                             class="h-48 w-full object-cover"
                             alt="{{ a.titre }}">
                    {% else %}
                        <img src="{{ asset('images/default.jpg') }}"
                             class="h-48 w-full object-cover"
                             alt="default">
                    {% endif %}

            <div class="p-5">

                <p class="text-sm text-emerald-600">
                    {{ a.publierle|date('d/m/Y') }}
                </p>

                <h2 class="font-bold text-xl mt-1">
                    {{ a.titre }}
                </h2>

                <p class="text-gray-600 text-sm mt-3 line-clamp-3">
                    {{ a.contenu|slice(0, 120) ~ '...' }}
                </p>

                <a href="#"
                   class="inline-block mt-4 px-4 py-2 bg-emerald-600 text-white rounded-xl text-sm hover:bg-emerald-700">
                    Lire plus
                </a>

            </div>
        </div>

    {% else %}

        <p class="text-gray-500">Aucune actualité disponible.</p>

    {% endfor %}

</div>


        




</main>

</body>
</html>