           📞 Contacts
        </a>

    </nav>

</div>

<!-- ================= SCRIPT ================= -->
<script>
function toggleMobileMenu() {
    const menu = document.getElementById('mobileMenu');
    const backdrop = document.getElementById('backdrop');

    menu.classList.remove('-translate-y-full');
    menu.classList.add('translate-y-0');

    backdrop.classList.remove('hidden');

    document.body.style.overflow = "hidden";
}

function closeMobileMenu() {
    const menu = document.getElementById('mobileMenu');
    const backdrop = document.getElementById('backdrop');

    menu.classList.add('-translate-y-full');
    menu.classList.remove('translate-y-0');

    backdrop.classList.add('hidden');

    document.body.style.overflow = "";
}

function setActiveVisitorLink(clickedLink) {
    const links = document.querySelectorAll('a[data-nav-link="visitor"]');

    links.forEach(link => {
        link.classList.remove('text-yellow-300', 'underline', 'decoration-2', 'decoration-yellow-300', 'underline-offset-2');
        link.classList.add('text-white');
    });

    clickedLink.classList.remove('text-white');
    clickedLink.classList.add('text-yellow-300', 'underline', 'decoration-2', 'decoration-yellow-300', 'underline-offset-2');
}

function determineVisitorActiveTarget() {
    const hash = window.location.hash;
    if (hash) {
        return hash;
    }

    const pathname = window.location.pathname.toLowerCase();

    if (pathname.includes('actualit')) {
        return '#actualites';
    }
    if (pathname.includes('evenement')) {
        return '#evenements';
    }
    if (pathname.includes('information')) {
        return '#informations';
    }
    if (pathname.includes('apropos')) {
        return '#apropos';
    }
    if (pathname.includes('contact')) {
        return '#contacts';
    }

    return '#Accueil';
}

function updateActiveVisitorLinkByHash() {
    const target = determineVisitorActiveTarget();
    const links = Array.from(document.querySelectorAll('a[data-nav-link="visitor"]'));
    const matchedLink = links.find(link => new URL(link.href, window.location.href).hash === target);

    if (matchedLink) {
        setActiveVisitorLink(matchedLink);
    }
}

window.addEventListener('DOMContentLoaded', () => {
    const visitorLinks = document.querySelectorAll('a[data-nav-link="visitor"]');

    visitorLinks.forEach(link => {
        link.addEventListener('click', event => {
            setActiveVisitorLink(event.currentTarget);
        });
    });

    updateActiveVisitorLinkByHash();
});

window.addEventListener('hashchange', updateActiveVisitorLinkByHash);
</script>