        <a href="{{ path('app_interfacevisiteur') }}"
           class="flex items-center gap-3">

            <img src="{{ asset('images/Logo.jpg') }}"
                 class="h-12 w-12 rounded-full object-cover border-2 border-white shadow-md">

            <span class="text-white font-bold text-xl tracking-wide">
                ORMada
            </span>
        </a>

        <button onclick="closeMobileMenu()"
                class="text-white text-3xl hover:text-red-300 transition">
            ×
        </button>

    </div>

    <!-- MENU -->
    <nav class="mobile-nav flex flex-col text-white font-semibold px-6 py- gap-4">

        <a href="{{ path('app_interfacevisiteur') }}#Accueil"
           data-nav-link="visitor"
           onclick="closeMobileMenu()"
           class="text-white hover:text-yellow-300 hover:bg-green-700 px-4 py-3 rounded-xl transition mt-6">
            📰 Accueil
        </a>
        <a href="{{ path('app_interfacevisiteur') }}#actualites"
           data-nav-link="visitor"
           onclick="closeMobileMenu()"
           class="text-white hover:text-yellow-300 hover:bg-green-700 px-4 py-3 rounded-xl transition">
           📰 Actualités
        </a>

        <a href="{{ path('app_interfacevisiteur') }}#evenements"
