{{ form_start(form) }}

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <!-- Upload Images -->
    <div class="md:col-span-2">

        {{ form_label(form.images,null,{
            'label_attr':{
                'class':'block text-sm font-semibold text-gray-700 mb-2'
            }
        }) }}

        <div class="relative">

            {{ form_widget(form.images,{
                'attr':{
                    'class':'w-full px-4 py-3
                    rounded-2xl
                    border-2 border-dashed border-emerald-300
                    bg-gradient-to-r from-emerald-50 to-green-50
                    text-gray-600
                    cursor-pointer
                    hover:border-emerald-500
                    hover:bg-emerald-100
                    transition duration-300'
                }
            }) }}

        </div>

    </div>


    <!-- Titre -->
    <div>

        {{ form_label(form.titre,null,{
            'label_attr':{
                'class':'block text-sm font-semibold text-gray-700 mb-2'
            }
        }) }}

        {{ form_widget(form.titre,{
            'attr':{
                'placeholder':'Titre de l’actualité',
                'class':'w-full px-4 py-3
                rounded-xl
                border border-gray-200
                bg-gray-50
                text-sm
                focus:bg-white
                focus:ring-2
                focus:ring-emerald-500
                focus:border-emerald-500
                focus:outline-none
                transition duration-300'
            }
        }) }}

    </div>


    <!-- Date -->
    <div>

        {{ form_label(form.publierle,null,{
            'label_attr':{
                'class':'block text-sm font-semibold text-gray-700 mb-2'
            }
        }) }}

        {{ form_widget(form.publierle,{
            'attr':{
                'class':'w-full px-4 py-3
                rounded-xl
                border border-gray-200
                bg-gray-50
                focus:ring-2
                focus:ring-emerald-500
                focus:border-emerald-500
                focus:outline-none'
            }
        }) }}

    </div>


    <!-- Contenu -->
    <div class="md:col-span-2">

        {{ form_label(form.contenu,null,{
            'label_attr':{
                'class':'block text-sm font-semibold text-gray-700 mb-2'
            }
        }) }}

        {{ form_widget(form.contenu,{
            'attr':{
                'rows':'4',
                'placeholder':'Contenu de l’actualité...',
                'class':'w-full px-4 py-3
                rounded-xl
                border border-gray-200
                bg-gray-50
                resize-none
                text-sm
                focus:bg-white
                focus:ring-2
                focus:ring-emerald-500
                focus:border-emerald-500
                focus:outline-none
                transition duration-300'
            }
        }) }}

    </div>


    <!-- Publication -->
    <div class="md:col-span-2">

        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4 flex items-center justify-between">

            <div>

                <p class="font-semibold text-gray-700">

                    Publier immédiatement

                </p>

                <p class="text-xs text-gray-500">

                    Activer pour rendre l’actualité visible

                </p>

            </div>

            {{ form_widget(form.dejapublier,{
                'attr':{
                    'class':'w-5 h-5 text-emerald-600 rounded focus:ring-emerald-500'
                }
            }) }}

        </div>

    </div>

</div>


<!-- Actions -->
<div class="flex justify-end gap-3 mt-5 border-t pt-4">

    <a href="{{ path('app_actualite_index') }}"
       class="px-6 py-3
              rounded-xl
              border border-gray-300
              text-gray-700
              font-medium
              hover:bg-gray-100
              transition">

        Annuler

    </a>


    <button type="submit"
            class="px-6 py-3
                   rounded-xl
                   bg-gradient-to-r
                   from-emerald-700
                   to-emerald-600
                   hover:from-emerald-800
                   hover:to-emerald-700
                   text-white
                   font-semibold
                   shadow-lg
                   hover:shadow-xl
                   transition duration-300">

        Enregistrer

    </button>

</div>

{{ form_end(form) }}